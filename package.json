{
  "name": "patient-event-ingest",
  "version": "0.1.0",
  "private": true,
  "description": "Ingests patient events over HTTP and processes them asynchronously",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:dev": "nest start --watch",
    "start:dev:worker": "nest start --watch --entryFile worker",
    "test": "tsc -p tsconfig.spec.json && node --test \"dist-test/test/*.test.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/mongoose": "^12.0.1",
    "@nestjs/platform-express": "^12.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mongoose": "^9.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.0",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
