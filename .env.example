# Connection string used when running the service on the host (npm run start:dev,
# tests). directConnection=true tells the driver to skip replica set discovery:
# without it the driver would ask the server for the set topology, get back the
# member host "mongo:27017" registered by rs-init.js, and fail to resolve it
# outside the Docker network. Inside Docker the URL is set in docker-compose.yml.
MONGO_URL=mongodb://localhost:27017/ingest?directConnection=true

PORT=3000
