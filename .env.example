# Connection string used when running the service on the host (npm run start,
# npm run start:worker, tests). directConnection=true tells the driver to skip
# replica set discovery: without it the driver would ask the server for the set
# topology, get back the member host "mongo:27017" registered by rs-init.js, and
# fail to resolve it outside the Docker network. Inside Docker the URL is set in
# docker-compose.yml.
MONGO_URL=mongodb://localhost:27017/ingest?directConnection=true

PORT=3000

# Events one worker process handles at once. 1000 events/min at ~5s each is
# ~83 in flight across the whole system, so two replicas at 50 leaves headroom
# to drain a backlog after an incident.
WORKER_CONCURRENCY=50

# How long a claim stays valid. Shorter means a crashed worker's events come
# back sooner; longer means a worker that is merely slow keeps its work.
LEASE_MS=30000

# Attempts before an event reaches the terminal failed state.
MAX_ATTEMPTS=5

# The ~5 seconds the assignment asks us to simulate.
EXTERNAL_PROCESSING_MS=5000

# Fraction of external calls that fail, for exercising the retry path.
EXTERNAL_FAILURE_RATE=0
